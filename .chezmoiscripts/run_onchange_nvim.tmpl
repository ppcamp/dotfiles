{{- if has "nvim" .scripts -}}
#!/usr/bin/env bash

{{ template "helpers.tmpl" . }}



# TODO: upgrade this file

# This script installs the latest version of Neovim (nvim) from the official
# GitHub releases.

pkgCreator=neovim
pkg=neovim
folder=$HOME/.local # /opt/nvim

{{ template "github_setup.tmpl" . }}

# Download and install nvim directly to $folder
# sudo rm -rf $folder
getGithubFileStdin "nvim-linux-x86_64.tar.gz" |
  tar -xz --transform='s/^nvim-linux-x86_64//' -C $folder 2>/dev/null


################################################################################
# Create a symlink to the nvim binary in /usr/local/bin
#
# sudo ln -sf $folder/bin/nvim /usr/local/bin/nvim


################################################################################
# Create desktop entry
#   ideally, we would use `chmod +x $HOME/.local/share/applications/nvim.desktop`, but
#   for some reason, ubuntu does not understand this.
# sudo desktop-file-install "$folder/share/applications/nvim.desktop"

# configure the entry, to match this new app path
#   (to keep the application isolated as possible from `env`)
desktop-file-edit \
  --set-key Icon \
  --set-value "$folder/share/icons/hicolor/128x128/apps/nvim.png" \
  $folder/share/applications/nvim.desktop

# sudo desktop-file-edit \
#  --set-key Exec \
#  --set-value "/usr/bin/env kitty nvim %F" \
#  /usr/share/applications/nvim.desktop

# sudo desktop-file-edit \
#  --set-key TryExec \
#  --set-value "/usr/bin/env kitty nvim" \
#  /usr/share/applications/nvim.desktop

################################################################################
# update entries
update-desktop-database

# sudo update-desktop-database ~/.local/share/applications
# sudo desktop-file-validate $HOME/.local/share/applications/nvim.desktop


################################################################################
# Create a symlink to the nvim config directory in the user's home directory
# sudo mkdir -p /root/.config/
# sudo ln -sf $HOME/.config/nvim /root/.config/nvim

################################################################################
# Print warnings
warn "Some nvim plugins may require extra tools to work, such as:"
printf "   - rg\n"
printf "   - fzf\n"
printf "   - nodejs\n"
printf "   - python3\n"
printf "   - golang\n"
printf "   - lua (due to lualine)\n"
printf "\033[0m\n"

{{ end -}}
