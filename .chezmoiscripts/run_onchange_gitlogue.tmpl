{{ template "github_setup.tmpl" . }}

# downloading package
getGithubFileStdin "${pkg}-${version}-x86_64-unknown-linux-gnu.tar.gz" \
  | tar -xzC .

{{ template "install_home.tmpl" . }}

{{ end -}}
