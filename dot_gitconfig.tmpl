[user]
name = {{ .git.name }}
email = {{ .git.email }}

{{- if .git.sign }}
signingkey = {{ .git.sign }}
{{- end }}

[commit]
template = ~/.git-template
{{- if .git.sign }}
gpgsign = true

{{-     if .git.ssh }}
[gpg]
format = ssh

[gpg "ssh"]
allowedSignersFile = ~/.ssh/allowed_signers
{{-     end }}
{{- end }}

[safe]
directory = /usr/share/nvim

[url "git@bitbucket.org:"]
insteadOf = https://bitbucket.org/

[push]
autoSetupRemote = true

[pull]
rebase = true

[credential]
helper = store

[init]
defaultBranch = main

[core]
editor = nvim #code --wait
#pager = less -IR -
pager = delta
abbrev=7

[delta]
features = mellow-barbet

[interactive]
diffFilter = delta --color-only

[rerere]
enabled = true

[diff]
# diffstatic is just a post-processor visualizer for unified diffs
# (generated by git, or by the `diff` gnu command). Thus, when you
# change the diff command, the output won't be valid diff, instead
# it'll be a visual repr of the diff, therefore, an invalid patch.
#
# To avoid such problems, prefer to use git aliases, or difftool.
tool = meld
colorMoved = default
mnemonicPrefix = true
algorithm = histogram
#external = difft # DO NOT CHANGE THIS, otherwise, you won't be able to generate valid patch files

[difftool]
prompt = false

[difftool "difft"]
cmd = difft --tab-width 2 --context 0 --skip-unchanged --display side-by-side "$LOCAL" "$REMOTE"

[difftool "meld"]
cmd = meld "$LOCAL" "$REMOTE"
trustExitCode = true

[difftool "goland"]
cmd = goland diff $LOCAL $REMOTE
trustExitCode = true

[difftool "vscode"]
cmd = code --wait --diff $LOCAL $REMOTE
trustExitCode = true

[difftool "nvim"]
cmd = nvim -d "$LOCAL" "$REMOTE"
trustExitCode = true

[pager]
# Use a pager if the difftool output is larger than one screenful,
# consistent with the behaviour of `git diff`.
difftool = true

[merge]
ff = false
tool = meld
prompt = true
#conflictstyle = zdiff3 # show the base version in the middle of the conflict markers

[mergetool]
keepBackup = false # clean up backup files after merge

[mergetool "meld"]
cmd = meld "$LOCAL" "$BASE" "$REMOTE" --output "$MERGED"
trustExitCode = true

[mergetool "goland"]
cmd = goland merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED" > /dev/null 2>&1
trustExitCode = true

[mergetool "vscode"]
cmd = code --wait $MERGED
trustExitCode = true

[mergetool "nvim"]
cmd = nvim -d "$LOCAL" "$BASE" "$REMOTE" -c 'wincmd J | wincmd =' "$MERGED"
trustExitCode = true
keepBackup = false
prompt = true

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true

[rebase]
autoStash = true
autoSquash = true

[alias]
# remember that any external command must be found placed at /bin/ or /usr/bin
# gitx: plugin needs to be installed in the /usr/bin (you can find it in "shell" repo)
a = add
aa = add -A
ap = add --patch
alias = config --get-regexp alias
authors = shortlog --summary --email --numbered --no-merges
authorsx = !gitx --run authors # (all authors that commited) example: <git authors>
b = branch
bm = branch --merged
bed = branch --edit-description
bsd = branch --show-description
br = branch -D
c = commit
ca = commit --amend
caf = commit --amend --no-edit
ci = commit --interactive
cleanf = clean -df                           # (clean untracked files) example: <git reset-clean>
cm = commit -m
co = checkout
conflicts = diff --name-only --diff-filter=U # (show conflicts) example: <git conflicts>
cp = cherry-pick                             # cherry pick a commit, example: <git cp ..branchName> or <git cp commitHash>
cpn = cherry-pick -n                         # cherry pick , but no commit
curr = branch --show-current                 # (current branch) example: <git curr>
del = !gitx --run delete                     # example: <git delete>
del-remote = push origin --delete            # (delete a given branch in remote) example: <git delete-remote branchName>
delta = !git diff | delta
d = diff --word-diff --find-copies --find-renames --color
ds = d --staged
do = d @{u} # diff against upstream
dt = difftool
dts = dt --staged
exist-remote = ls-remote --heads origin # (check if exist in remote) example: <git exist-remote branchName>
f = fetch --prune
gcf = gc --aggressive # optimize the repository, (also use git f) example: <git optmize> (see git gc)
ga = grep --color -G # <git ga 'stringToSearch' README.md>
gg = grep --break --heading --line-number --color
graph = ls --graph # example: <git graph develop feature/some-14> or just <git graph>
graphx = graph --abbrev-commit --all
hard = reset --hard
hist = !gitx --run hashes                                                                                                                              # (it requires to have installed the gitx plugin)
health = fsck                                                                                                                                          # (check the health of the repository) example: <git health>
lazy = !LANG=en_US.UTF-8 lazygit -sm=full log                                                                                                          # (execute lazygit cmd)
list = branch -v                                                                                                                                       # (list local branches) example: <git list>
list-remotes = branch --remotes                                                                                                                        # (list remote branches ref) example: <git list-remotes>
ll = ls --name-only                                                                                                                                    # alternative to <git log>, example: <git ls>
local-branches = !git branch -v | cut -c 3- | awk '{ print $2\" \"$1 }'                                                                                # (show local only branches) example: <git local-branches>
log-deleted = log --diff-filter=D --                                                                                                                   # (show logged files, alternativaly, you can pass a directory to search for) example: <git log-deleted>
ls = log --format=format:'%C(bold yellow)%h%C(reset) %C(reset)%s%C(bold blue)%d%C(reset) %C(dim white)%an [%G?] (%ad, %ar)%C(reset)' --decorate --date=short # alternative to <git log>, example: <git ls>
lsp = ls --follow --first-parent # show merges commits only
merge-find-commit = "!f() { c=$(git rev-parse --verify \"$1^{commit}\") || return 1; b=${2:-HEAD}; m=$( { git rev-list --ancestry-path \"$c..$b\"; echo ---; git rev-list --first-parent \"$c.. } | awk '/^---$/{s=1;next} !s{a[$0]=1;next} a[$0]{m=$0} END{print m}'); if [ -n \"$m\" ]; then git show -s --format='%h %s (%ad)' --date=short \"$m\"; else echo \"no merge found\" >&2; return 1; fi; }; f"
merge-find-latest-branch-by-commit="!f(){ for b in $(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes | grep -v HEAD); do [ "$(git log -1 --merges --format=%h "$b")" = "$1" ] && echo "$b"; done }"
merges = ls --merges # merges main..develop
new = switch --create                                                                                                                                      # (create new branches) example: <git new branchName>
p = pull
pr = pull --rebase
prs = submodule update --init --recursive --remote --rebase
patch = !git add -N . && git diff HEAD
pushf = push --force --progress                            # (force push) example: <git pushf>
recent-branches = !git branch --sort=-committerdate | head # (show recent branches) example: <git recent-branches>
rename = branch -m                                         # (rename branch locally, remember to <git push origin branch> + <git delete-remote>) example: <git rename newName>
rename-remote = "!fn() { git branch -m \"$1\" \"$2\" && git push origin \"$2\" && git push origin --delete \"$1\" && git push --set-upstream origin \"$2\"; }; fn"
reset-all = !git reset-untracked && git reset-hard # (clean all- (un)tracked files) example: <git reset-all>
reset-hard = reset --hard HEAD                     # (clean tracked files) example: <git reset-hard>
rt = restore
rts = restore -s
rtc = restore -S
s = status --short
ss = status --long --show-stash
soft = reset --soft
squash-all = "!f(){ git reset $(git commit-tree \"HEAD^{tree}\" \"$@\");};f" # (recreate git tree) example: <git squash-all -m 'init (squased)'
stashes = !gitx --run stashes # (it requires to have installed the gitx plugin)
sw = switch
sww = switch - # swap branches
swx = !gitx --run branches    # (it requires to have installed the gitx plugin)
sync = !git f && git p        # (fetch and pull) example: <git sync>
tags = !gitx --run tags       # (it requires to have installed the gitx plugin)
top = !git ls | head -n5
what = ls --follow --full-history --  # (whatchanged) shows the history of a path/file (e.g, git track file.go)
unmodule = submodule deinit -f
unstage = restore --staged
unstage-all = unstage -S .
w = worktree
# create a worktree at ~/.git-worktrees/<repo>-<branch> (slashes flattened to dashes),
# checking out <branch> if it exists (locally or on a remote) or creating it otherwise.
# example: <git wa feature/login> -> ~/.git-worktrees/myrepo-feature-login
wa = "!f() { r=$(basename \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"); p=\"$HOME/.git-worktrees/$r-$(printf %s \"$1\" | tr '/' '-')\"; git worktree add \"$p\" \"$1\" 2>/dev/null || git worktree add -b \"$1\" \"$p\"; }; f"
# remove the worktree that <git wa> created for <branch>; extra flags (e.g. --force) pass through.
# example: <git wr feature/login> -> removes ~/.git-worktrees/myrepo-feature-login
wr = "!f() { b=$1; shift; r=$(basename \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"); git worktree remove \"$@\" \"$HOME/.git-worktrees/$r-$(printf %s \"$b\" | tr '/' '-')\"; }; f"
# `git wcd <branch>` jumps into one of those worktrees. It is deliberately not
# an alias: an alias runs in a child process and cannot change the shell's
# directory, so it is a zsh function in ~/.local/share/shell/snippets/functions.sh
wip = !git add -A && git commit -m 'WIP' # Work In Progress commit
wipb = switch --create wip # Work In Progress commit
worktrees = !gitx --run worktrees        # (it requires to have installed the gitx plugin)
